# Supabase Functions Environment Configuration
# Copy this file to .env in the supabase directory for local development

# EmailJS Configuration for Supabase Functions
# Sign up at https://emailjs.com/ to get your credentials
# The Supabase functions use EmailJS to send emails
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Site URL for email links (change to your deployed URL in production)
SITE_URL=http://localhost:8080

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/your-project-id/settings/api
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Note: Service Role Key has admin privileges - keep it secret!
# Only use this key for server-side operations (Supabase Functions)